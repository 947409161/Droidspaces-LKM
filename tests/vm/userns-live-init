#!/bin/sh
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo 0 > /proc/sys/kernel/kptr_restrict
run_tests() {
    /load-module /namespaces.ko activate=1 || return 1
    /userns-live-test || return 1
    unshare -ip true || return 1
    sleep 1
    cat /sys/module/droidspaces_ns/parameters/userns_live
    test "$(cat /sys/module/droidspaces_ns/parameters/userns_live)" = 0 || return 1
    dmesg | tail -n 15
}
run_tests
result=$?
echo "DS_USERNS_LIVE_VM_RESULT=$result"
poweroff -f
